# URL base del sitio (sin slash final). Se usa para canonical, Open Graph, sitemap, etc.
# En producción: la URL real del dominio del cliente.
PUBLIC_SITE_URL=https://www.mallkustudio.com

# Permite la indexación por buscadores. Dejar sin definir mientras el sitio
# viva en una URL *.pages.dev (sin dominio propio). Solo "true" la habilita.
PUBLIC_ALLOW_INDEXING=
