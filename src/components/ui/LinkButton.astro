---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'ghost';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: Variant;
}

const { variant = 'primary', class: className, ...rest } = Astro.props;

const variantClass: Record<Variant, string> = {
  primary: 'border-accent bg-accent text-background hover:border-accent-light hover:bg-accent-light',
  ghost: 'border-border text-foreground hover:border-accent hover:text-accent-light',
};
---

<a
  class:list={[
    'inline-flex min-h-11 items-center justify-center gap-2 rounded-full border px-6 text-small font-medium no-underline transition-colors duration-(--duration-fast) ease-standard',
    variantClass[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
